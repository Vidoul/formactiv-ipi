# =============================================================================
# FORMACTIV — variables de PRODUCTION (modèle). Copier en .env.production, jamais versionné.
# Tous les secrets sont à générer pour l'environnement (cf. docs/exploitation.md) :
#   openssl rand -base64 48    (secrets JWT et URL signées)
#   openssl rand -hex 32       (clé de chiffrement des secrets MFA)
# =============================================================================

# Base de données (service postgres de docker-compose.prod.yml)
POSTGRES_USER=formactiv
POSTGRES_PASSWORD=
POSTGRES_DB=formactiv

# Port d'écoute de Nginx sur l'hôte (derrière le reverse proxy TLS de l'hébergeur)
WEB_PORT=8080

# URL publique (HTTPS) : liens des emails et origine autorisée
WEB_URL=https://formactiv.example.fr
CORS_ORIGINS=https://formactiv.example.fr

# Jetons et secrets
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDES=900
JWT_MFA_SECRET=
REFRESH_TOKEN_TTL_JOURS=7
COOKIE_SECURE=true
MFA_ENCRYPTION_KEY=
DOCUMENT_URL_SECRET=
DOCUMENT_URL_TTL_SECONDES=300

# Messagerie (SMTP authentifié, TLS)
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FORMACTIV <no-reply@formactiv.example.fr>"

# Stockage des PDF : s3 recommandé en production (hébergeur UE, bucket privé, ADR-05)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PASSWORD_PWNED_CHECK=true
SWAGGER_ENABLED=false
THROTTLE_LIMITE_GLOBALE=300
THROTTLE_LIMITE_AUTH=10

# Administrateur initial créé au premier déploiement (mot de passe conforme RG-AUTH-01,
# à changer à la première connexion ; MFA obligatoire).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
